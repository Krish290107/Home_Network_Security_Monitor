# Copy this file to .env and adjust the values.

# ---- Network discovery -------------------------------------------------
# Optional. Leave blank to auto-detect the local /24 subnet.
NETWORK_RANGE=

# ---- Nmap --------------------------------------------------------------
# Optional. Leave blank to use the `nmap` binary found on PATH.
# Windows:      NMAP_PATH=C:\Program Files\Nmap\nmap.exe
# macOS/Linux:  NMAP_PATH=/usr/bin/nmap
NMAP_PATH=

# ---- Scheduler (seconds) -----------------------------------------------
NETWORK_SCAN_INTERVAL=60
PORT_SCAN_INTERVAL=300

# ---- Flask dashboard ---------------------------------------------------
# Leave blank. app.py generates one automatically on first run and saves
# it back to this file, so it persists across restarts with no manual step.
FLASK_SECRET_KEY=
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
